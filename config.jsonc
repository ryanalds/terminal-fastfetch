{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": {
    "type": "kitty-direct",
    "source": "/home/ryanalds/Imagens/terminal/heisenberg-pixelart-flat.png",
    "position": "left",
    "width": 42,
    "height": 21,
    "padding": { "top": 0, "right": 3 }
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "38;5;220",
      "title": "38;5;37",
      "output": "38;5;109",
      "separator": "38;5;166"
    },
    "key": { "width": 16 }
  },
  "modules": [
    "title",

    { "type": "custom", "format": "────────────── Sistema ──────────────", "outputColor": "38;5;240" },
    { "type": "os",           "key": "\uf30a OS" },
    { "type": "kernel",       "key": "\uf17c Kernel" },
    { "type": "uptime",       "key": "\uf017 Uptime" },
    { "type": "packages",     "key": "\uf487 Pacotes" },
    { "type": "shell",        "key": "\uf120 Shell" },

    { "type": "custom", "format": "───────────── Hardware ──────────────", "outputColor": "38;5;240" },
    { "type": "host",         "key": "\uf109 Host",     "outputColor": "38;5;81" },
    { "type": "cpu",          "key": "\uf2db CPU",      "format": "{name} ({core-types})", "outputColor": "38;5;81" },
    { "type": "gpu",          "key": "\uf1b2 GPU",      "outputColor": "38;5;81" },
    { "type": "memory",       "key": "\uf538 Memória",  "outputColor": "38;5;81" },
    { "type": "swap",         "key": "\uf0ec Swap",     "outputColor": "38;5;81" },
    { "type": "disk",         "key": "\uf0a0 Disco",    "outputColor": "38;5;81" },
    { "type": "display",      "key": "\uf26c Tela",     "outputColor": "38;5;81" },
    { "type": "battery",      "key": "\uf240 Bateria",  "outputColor": "38;5;81" },
    { "type": "poweradapter", "key": "\uf1e6 Energia",  "outputColor": "38;5;81" },

    { "type": "custom", "format": "──────────────── Rede ────────────────", "outputColor": "38;5;240" },
    { "type": "localip",      "key": "\uf1eb IP Local", "outputColor": "38;5;114" },
    { "type": "locale",       "key": "\uf0ac Locale",   "outputColor": "38;5;114" },

    { "type": "custom", "format": "─────────────────────────────────────", "outputColor": "38;5;240" },
    "break",
    {
      "type": "custom",
      "format": "{#38;5;109}⚗{#}  {#38;5;37}⚗{#}  {#38;5;114}⚗{#}  {#38;5;148}⚗{#}  {#38;5;220}⚗{#}  {#38;5;166}⚗{#}  {#38;5;160}⚗{#}  {#38;5;141}⚗{#}"
    },
    "break"
  ]
}
